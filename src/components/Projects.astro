---
import LinkButton from "./LinkButton.astro";
import GitHub from "./icons/GitHub.astro";
import React from "./icons/React.astro";
import ExpressJS from "./icons/Express.astro";
import Bulma from "./icons/Bulma.astro";
import ChakraUi from "./icons/ChakraUi.astro";
import MySql from "./icons/MySql.astro";
import Eye from "./icons/Eye.astro";
import SQLite from "./icons/SQLite.astro"
import Expo from "./icons/Expo.astro"
import MaterialUI from "./icons/MaterialUI.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import JavaScript from "./icons/JavaScript.astro";
import Php from "./icons/Php.astro";
import Supabase from "./icons/Supabase.astro";
import PostgreSQL from "./icons/PostgreSQL.astro";
import Firebase from "./icons/Firebase.astro";



const TAGS = {
  SQLITE: {
    name: "SQLite",
    class: "text-gray-300 font-medium border border-blue-500 bg-sky-500/30",
    icon: SQLite
  },
  BULMA: {
    name: "BULMA",
    class: "text-gray-300 font-medium border border-blue-500 bg-sky-500/30",
    icon: Bulma,
  },
  REACT: {
    name: "React",
    class: "text-gray-300 font-medium border border-blue-500 bg-sky-500/30",
    icon: React,
  },
  REACTNATIVE: {
    name: "React Native",
    class: "text-gray-300 font-medium border border-blue-500 bg-sky-500/30",
    icon: React,
  },
  EXPRESSJS: {
    name: "Express JS",
    class: "text-gray-300 font-medium border border-gray-500 bg-gray-500/30",
    icon: ExpressJS,
  },
  CHAKRAUI: {
    name: "Chakra UI",
    class: "text-gray-300 font-medium border border-teal-500 bg-teal-500/30",
    icon: ChakraUi,
  },
  MYSQL: {
    name: "MySQL",
    class: "text-gray-300 font-medium border border-gray-500 bg-gray-500/30 ",
    icon: MySql,
  },
  EXPO: {
    name: "Expo ",
    class: "text-gray-300 font-medium border border-neutral-500 bg-neutral-500/30",
    icon: Expo
  }, 
  MATERIALUI: {
    name: "Material UI",
    class: "text-gray-300 font-medium border border-blue-500 bg-blue-500/30",
    icon: MaterialUI 
  },
  BOOTSTRAP: {
    name: "Bootstrap",
    class: "text-gray-300 font-medium border border-violet-500 bg-violet-500/30",
    icon: Bootstrap 
  },
  JAVASCRIPT: {
    name: "Vanilla JavaScript",
    class: "text-gray-300 font-medium border border-yellow-500 bg-yellow-500/30",
    icon: JavaScript,
  },
  PHP: {
    name: "PHP",
    class: "text-gray-300 font-medium border border-indigo-500 bg-indigo-500/30",
    icon: Php,
  },
  FIREBASE: {
    name: "Firebase",
    class: "text-gray-300 font-medium border border-amber-500 bg-amber-500/30",
    icon: Firebase,
  },
  SUPABASE: {
    name: "Supabase",
    class: "text-gray-300 font-medium border border-emerald-500 bg-emerald-500/30",
    icon: Supabase,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "text-gray-300 font-medium border border-blue-500 bg-blue-500/30",
    icon: PostgreSQL,
  }
};

const PROJECTS = [
  {
    title: "FITX",
    description: "App de entrenamiento incluye funcionalidades como escaneo corporal  y escaneo de comida. Con panel administrativo. Desarrollada de forma freelance.",
    image: "/projects/fitx.webp",
    tags: [TAGS.REACTNATIVE, TAGS.EXPO, TAGS.FIREBASE, TAGS.SQLITE, TAGS.EXPRESSJS],
    deploy: "https://apps.apple.com/us/app/fitx/id6745495908"
  },
  {
    title: "Strength Up",
    description: "App para registrar tus entranamientos y aplicar sobrecarga progresiva.",
    image: "/projects/strength-up.webp",
    tags: [TAGS.REACTNATIVE, TAGS.SUPABASE, TAGS.EXPO, TAGS.POSTGRESQL],
    deploy: "https://play.google.com/store/apps/details?id=com.pabris.StrengthUp"
    },
  {
    title: "ALUMNI",
    description: "Alumni del ISTMS, Plataforma Institucional",
    image: "/projects/alumni.webp",
    tags: [TAGS.REACT, TAGS.EXPRESSJS, TAGS.MATERIALUI, TAGS.MYSQL],
    deploy: "https://aplicaciones.marianosamaniego.edu.ec/alumni/login",
  },

  {
    title: "Sistema de enfermería",
    description:
      "Sistema de enfermería para el control de fichas médicas para la institución ITSMS",
    image: "/projects/sistema_clinico.webp",
    tags: [TAGS.JAVASCRIPT, TAGS.PHP, TAGS.BOOTSTRAP, TAGS.MYSQL],
    deploy: "https://aplicaciones.marianosamaniego.edu.ec/enfermeria/",
  },
  
  {
    title: "Minimalist Player",
    description: "Reproductor de música, desarrollado en React Native",
    image: "/projects/musicplayer.webp",
    tags: [TAGS.REACTNATIVE],
    github: "https://github.com/patricio-alexander/musicplayer",
  },
  {
    title: "Iron Subscription",
    description:
      "App de Control de Pagos Mensuales para Gimnasios en React Native, Express, MySQL y React Native Paper",
    image: "/projects/ironsubscription.webp",
    tags: [TAGS.REACTNATIVE, TAGS.EXPRESSJS, TAGS.MYSQL],
    github: "https://github.com/patricio-alexander/client-native-gym",
  }, 

  
  {
    title: "Lista de tareas",
    description:
      "Lista de tareas desarrollado en React, Express JS, MySql y Bulma CSS.",
    image: "/projects/tasklist.webp",
    tags: [TAGS.REACT, TAGS.EXPRESSJS, TAGS.BULMA, TAGS.MYSQL],
    github: "https://github.com/patricio-alexander/taskAppReact",
  }
];
---

<div class="grid md:grid-cols-2 gap-4">
  {
    PROJECTS.map(({ title, description, image, tags, github, deploy }) => (
    <article class="relative group overflow-hidden rounded-xl shadow-xl h-9/10 bg-black/60" id="projects">
        <div class="h-80 overflow-hidden">
          <img
          alt={`Captura de pantalla de ${image}`}
          src={image}
          class="w-full  object-cover hover:scale-105 transition-transform duration-300"
          loading="lazy"
          />
        </div>
        

        <div class="p-6">
          <h3 class="text-2xl font-bold">{title}</h3>

          <div class="flex flex-wrap mt-2">
            <ul class="flex mb-2 gap-2 flex-wrap">
              {tags.map((tag) => (
                <li>
                  <span class={`flex items-center gap-x-2 rounded-full text-xs py-1 px-2 ${tag.class}`}>
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <p class="mt-2 text-gray-400">{description}</p>

            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-5" />
                  Código
                </LinkButton>
              )}

              {deploy && (
                <LinkButton href={deploy}>
                  <Eye class="size-5" />
                  Ver
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
